@using QuickFun.Games.Engines.MasterMind
@using QuickFun.Games.MasterMind.Strategies
@using QuickFun.Domain.Enums
@using QuickFun.Application.Interfaces
@using QuickFun.Domain.Entities

@inject IGameSessionService SessionService

@namespace QuickFun.Web.Components.Views

<div class="mastermind-view">
    @if (!isDifficultySelected)
    {
        <div class="difficulty-overlay">
            <h3 class="overlay-title">— SELECT DIFFICULTY —</h3>
            <div class="difficulty-buttons">
                <button class="btn-diff easy" @onclick="() => SelectDifficulty(new EasyStrategyMasterMind())">
                    EASY <small>4 colors · 4 slots</small>
                </button>
                <button class="btn-diff medium" @onclick="() => SelectDifficulty(new MediumStrategyMasterMind())">
                    MEDIUM <small>5 colors · 5 slots</small>
                </button>
                <button class="btn-diff hard" @onclick="() => SelectDifficulty(new HardStrategyMasterMind())">
                    HARD <small>6 colors · 6 slots</small>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="game-header">
            <p class="status-message">@Engine.Message</p>
            <p class="score">ATTEMPTS: @Engine.Score / @Engine.MaxAttempts</p>
            <button class="btn-change-level" @onclick="ChangeDifficulty">
                « CHANGE LEVEL
            </button>
        </div>

        <div class="color-legend">
            @for (int i = 0; i < Engine.Colors; i++)
            {
                var letter = ((char)('A' + i)).ToString();
                <div class="legend-item">
                    <div class="color-dot" style="background-color: @GetColor(letter); box-shadow: 0 0 6px @GetColor(letter);"></div>
                    <span>@letter</span>
                </div>
            }
        </div>

        <div class="guess-history">
            @foreach (var (guess, correctPos, correctCol) in Engine.GuessHistory)
            {
                <div class="guess-row">
                    <div class="guess-pegs">
                        @foreach (var ch in guess)
                        {
                            <div class="peg" style="background-color: @GetColor(ch.ToString()); box-shadow: 0 0 8px @GetColor(ch.ToString());">@ch</div>
                        }
                    </div>
                    <div class="feedback">
                        <span class="feedback-black">■ @correctPos</span>
                        <span class="feedback-white">□ @correctCol</span>
                    </div>
                </div>
            }
        </div>

        @if (!Engine.IsGameOver)
        {
            <div class="input-area">
                <div class="peg-input">
                    @for (int i = 0; i < Engine.CodeLength; i++)
                    {
                        var index = i;
                        <select class="peg-select" @bind="currentGuess[index]">
                            <option value="">?</option>
                            @for (int c = 0; c < Engine.Colors; c++)
                            {
                                var letter = ((char)('A' + c)).ToString();
                                <option value="@letter">@letter</option>
                            }
                        </select>
                    }
                </div>
                <button class="btn-submit" @onclick="SubmitGuess" disabled="@(!IsGuessComplete())">
                    ▶ SUBMIT
                </button>
            </div>
        }
        else
        {
            <div class="game-over-actions">
                <button class="btn-play-again" @onclick="PlayAgain">▶ PLAY AGAIN</button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public MasterMindEngine Engine { get; set; } = default!;

    private bool isDifficultySelected = false;
    private string[] currentGuess = Array.Empty<string>();

    protected override void OnInitialized()
    {
        Engine.OnGameFinished -= HandleSaveScore;
        Engine.OnGameFinished += HandleSaveScore;
    }

    private async Task SelectDifficulty(IMasterMindDifficultyStrategy strategy)
    {
        Engine.SetDifficulty(strategy);
        isDifficultySelected = true;
        currentGuess = new string[Engine.CodeLength];
        await Engine.Start(() => InvokeAsync(StateHasChanged));
    }

    private void ChangeDifficulty()
    {
        isDifficultySelected = false;
        Engine.OnReset();
    }

    private async Task PlayAgain()
    {
        currentGuess = new string[Engine.CodeLength];
        await Engine.Start(() => InvokeAsync(StateHasChanged));
    }

    private bool IsGuessComplete() =>
        currentGuess.Length == Engine.CodeLength && currentGuess.All(c => !string.IsNullOrEmpty(c));

    private async Task SubmitGuess()
    {
        if (!IsGuessComplete()) return;
        var guess = string.Join("", currentGuess);
        currentGuess = new string[Engine.CodeLength];
        await Engine.MakeGuess(guess, () => InvokeAsync(StateHasChanged));
    }

    private async void HandleSaveScore(int finalScore)
    {
        var result = new GameResult { Type = Engine.Type, Score = finalScore };
        await SessionService.AddGameResultAsync(result);
        await InvokeAsync(StateHasChanged);
    }

    private static string GetColor(string letter) => letter switch
    {
        "A" => "#e74c3c",
        "B" => "#3498db",
        "C" => "#2ecc71",
        "D" => "#f39c12",
        "E" => "#9b59b6",
        "F" => "#1abc9c",
        _ => "#555555"
    };
}

<style>
    .mastermind-view {
        width: 100%;
        max-width: 520px;
        margin: 0 auto;
        padding-bottom: 45px;
        font-family: 'Press Start 2P', monospace;
        background: #0a0a0a;
        color: #ffffff;
    }

    /* DIFFICULTY SCREEN */
    .difficulty-overlay {
        text-align: center;
        padding: 30px 20px;
    }

    .overlay-title {
        font-size: 0.7rem;
        color: #ffe600;
        letter-spacing: 0.1em;
        text-shadow: 2px 2px 0 #b38f00;
        margin-bottom: 24px;
    }

    .difficulty-buttons {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 15px;
    }

    .btn-diff {
        padding: 16px;
        border: none;
        border-radius: 0;
        font-family: 'Press Start 2P', monospace;
        font-size: 0.65rem;
        color: #000;
        cursor: pointer;
        box-shadow: 4px 4px 0 rgba(0,0,0,0.5);
        transition: all 0.1s steps(1);
        letter-spacing: 0.05em;
    }

    .btn-diff:hover { transform: translate(2px,2px); box-shadow: 2px 2px 0 rgba(0,0,0,0.5); }
    .btn-diff small { display: block; font-size: 0.45rem; margin-top: 6px; opacity: 0.8; font-family: 'Press Start 2P', monospace; }

    .easy   { background: #2ecc71; }
    .medium { background: #f39c12; }
    .hard   { background: #e74c3c; color: #fff; }

    /* GAME HEADER */
    .game-header { text-align: center; margin-bottom: 16px; }

    .status-message {
        font-size: 0.6rem;
        color: #ff7b00;
        text-shadow: 0 0 8px rgba(255,123,0,0.5);
        margin-bottom: 6px;
        min-height: 1.5em;
        letter-spacing: 0.05em;
    }

    .score {
        font-size: 0.55rem;
        color: #ffe600;
        margin-bottom: 10px;
        letter-spacing: 0.08em;
    }

    .btn-change-level {
        background: #1a1a1a;
        color: #ffe600;
        border: 2px solid #ffe600;
        padding: 8px 16px;
        font-family: 'Press Start 2P', monospace;
        font-size: 0.5rem;
        cursor: pointer;
        box-shadow: 2px 2px 0 #b38f00;
        transition: all 0.1s steps(1);
        letter-spacing: 0.05em;
    }

    .btn-change-level:hover {
        background: #ffe600;
        color: #000;
        box-shadow: 1px 1px 0 #b38f00;
        transform: translate(1px,1px);
    }

    /* COLOR LEGEND */
    .color-legend {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .legend-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        font-size: 0.5rem;
        color: #aaa;
    }

    .color-dot {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,0.2);
    }

    /* GUESS HISTORY */
    .guess-history {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 16px;
        max-height: 340px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #ffe600 #111;
    }

    .guess-row {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #111;
        border: 1px solid #222;
        padding: 8px 10px;
    }

    .guess-pegs { display: flex; gap: 6px; }

    .peg {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.5rem;
        font-family: 'Press Start 2P', monospace;
        color: #fff;
        text-shadow: 0 1px 2px rgba(0,0,0,0.8);
    }

    .feedback {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 0.5rem;
    }

    .feedback-black { color: #ffe600; }
    .feedback-white { color: #555; }

    /* INPUT */
    .input-area {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        margin-top: 10px;
    }

    .peg-input { display: flex; gap: 8px; }

    .peg-select {
        width: 52px;
        height: 48px;
        border-radius: 0;
        border: 2px solid #444;
        font-size: 0.6rem;
        font-family: 'Press Start 2P', monospace;
        font-weight: bold;
        text-align: center;
        cursor: pointer;
        background: #111;
        color: #fff;
        transition: border-color 0.1s;
    }

    .peg-select:focus { outline: none; border-color: #ffe600; }

    .btn-submit {
        background: #ffe600;
        color: #000;
        border: none;
        padding: 12px 28px;
        font-family: 'Press Start 2P', monospace;
        font-size: 0.6rem;
        cursor: pointer;
        box-shadow: 3px 3px 0 #b38f00;
        transition: all 0.1s steps(1);
        letter-spacing: 0.05em;
    }

    .btn-submit:hover:not(:disabled) {
        background: #ff7b00;
        color: #fff;
        box-shadow: 1px 1px 0 #b35000;
        transform: translate(2px,2px);
    }

    .btn-submit:disabled { background: #333; color: #555; cursor: not-allowed; box-shadow: none; }

    /* GAME OVER */
    .game-over-actions { text-align: center; margin-top: 20px; }

    .btn-play-again {
        background: #ff7b00;
        color: #fff;
        border: none;
        padding: 14px 32px;
        font-family: 'Press Start 2P', monospace;
        font-size: 0.6rem;
        cursor: pointer;
        box-shadow: 3px 3px 0 #b35000;
        transition: all 0.1s steps(1);
        letter-spacing: 0.05em;
    }

    .btn-play-again:hover {
        background: #ffe600;
        color: #000;
        box-shadow: 1px 1px 0 #b38f00;
        transform: translate(2px,2px);
    }
</style>
