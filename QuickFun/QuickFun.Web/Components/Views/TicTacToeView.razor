@using QuickFun.Games.Engines
@using QuickFun.Domain.Enums
@using QuickFun.Application.Interfaces
@using QuickFun.Domain.Entities
@using QuickFun.Games.Engines.TicTacToe
@inject IGameSessionService SessionService

@namespace QuickFun.Web.Components.Views

<div class="game-container">
    <p class="status-message">@Engine.Message</p>
    <p class="score-text">SCORE: @Engine.Score</p>

    <div class="board">
        @for (int i = 0; i < 9; i++)
        {
            int localIndex = i;
            var symbol = Engine.Board[i];
            <button class="cell @(symbol == 'X' ? "cell-x" : symbol == 'O' ? "cell-o" : "")"
                @onclick="() => HandleClick(localIndex)"
                disabled="@Engine.IsGameOver">
                @(symbol != '\0' ? symbol.ToString() : "")
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public TicTacToeEngine Engine { get; set; }

    private async Task HandleClick(int index)
    {
        if (Engine == null || Engine.IsGameOver) return;

        Engine.MakeMove(index);

        if (Engine.IsGameOver)
        {
            await SessionService.AddGameResultAsync(new GameResult
            {
                Type = Engine.Type,
                Score = Engine.Score
            });
        }
    }
}

<style>
    .game-container {
        max-width: 420px;
        margin: 0 auto;
        padding: 24px 20px;
        text-align: center;
        background: #0a0a0a;
        font-family: 'Press Start 2P', monospace;
        color: #ffffff;
    }

    .status-message {
        font-size: 0.6rem;
        color: #ff7b00;
        text-shadow: 0 0 8px rgba(255,123,0,0.5);
        min-height: 2rem;
        margin-bottom: 6px;
        letter-spacing: 0.05em;
    }

    .score-text {
        font-size: 0.55rem;
        color: #ffe600;
        margin-bottom: 16px;
        letter-spacing: 0.08em;
    }

    .board {
        display: grid;
        grid-template-columns: repeat(3, 100px);
        gap: 8px;
        justify-content: center;
        margin: 0 auto;
    }

    .cell {
        width: 100px;
        height: 100px;
        font-size: 2rem;
        font-family: 'Press Start 2P', monospace;
        cursor: pointer;
        background: #1a1a1a;
        border: 2px solid #333;
        border-radius: 0;
        color: #ffffff;
        box-shadow: 3px 3px 0 #000;
        transition: all 0.1s steps(1);
    }

    .cell:hover:not(:disabled) {
        background: rgba(255,123,0,0.15);
        border-color: #ff7b00;
        box-shadow: 1px 1px 0 #000;
        transform: translate(2px,2px);
    }

    .cell:disabled { cursor: not-allowed; }

    .cell-x { color: #ff7b00; text-shadow: 0 0 10px rgba(255,123,0,0.6); border-color: #ff7b00; }
    .cell-o { color: #ffe600; text-shadow: 0 0 10px rgba(255,230,0,0.6); border-color: #ffe600; }
</style>
