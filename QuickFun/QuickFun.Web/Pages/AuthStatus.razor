@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject HttpClient Http
@using System.Net.Http.Headers
@inject NavigationManager Nav

<div class="auth-status">
    @if (isLoggedIn)
    {
        <button class="nav-btn logout" @onclick="HandleLogout">LOG OUT</button>
    }
    else
    {
        <a class="nav-link-auth" href="/login">LOG IN</a>
        <a class="nav-link-auth sign-up" href="/register">SIGN UP</a>
    }
</div>

@code {
    private bool isLoggedIn = false;

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");

        if (string.IsNullOrEmpty(token))
        {
            isLoggedIn = false;
        }
        else
        {
            try
            {
                var request = new HttpRequestMessage(HttpMethod.Get, "api/account/me");
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
                var response = await Http.SendAsync(request);
                isLoggedIn = response.IsSuccessStatusCode;
                if (!isLoggedIn) await LocalStorage.RemoveItemAsync("authToken");
            }
            catch { isLoggedIn = false; }
        }
    }

    private async Task HandleLogout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        Nav.NavigateTo("/", forceLoad: true);
    }
}

<style>
    .auth-status {
        display: flex;
        gap: 12px;
        align-items: center;
        font-family: 'Press Start 2P', monospace;
    }

    .nav-link-auth {
        color: #ffffff;
        text-decoration: none;
        font-size: 0.45rem;
        letter-spacing: 0.08em;
        padding: 7px 12px;
        border: 2px solid #444;
        transition: all 0.1s steps(1);
    }

    .nav-link-auth:hover {
        color: #ff7b00;
        border-color: #ff7b00;
        text-decoration: none;
    }

    .sign-up {
        background: #ffe600;
        color: #000 !important;
        border: none;
        box-shadow: 2px 2px 0 #b38f00;
    }

    .sign-up:hover {
        background: #ff7b00 !important;
        color: #fff !important;
        box-shadow: 1px 1px 0 #b35000;
        transform: translate(1px, 1px);
        text-decoration: none !important;
    }

    .nav-btn {
        font-family: 'Press Start 2P', monospace;
        font-size: 0.45rem;
        letter-spacing: 0.08em;
        cursor: pointer;
        transition: all 0.1s steps(1);
    }

    .logout {
        background: transparent;
        border: 2px solid #e74c3c;
        color: #e74c3c;
        padding: 7px 12px;
        box-shadow: 2px 2px 0 #7b1c12;
    }

    .logout:hover {
        background: #e74c3c;
        color: #fff;
        box-shadow: 1px 1px 0 #7b1c12;
        transform: translate(1px, 1px);
    }
</style>
