@using QuickFun.Domain.Enums
@using Microsoft.JSInterop
@implements IDisposable
@inject IJSRuntime JS

<div class="slider-container">
    <h2 class="slider-title">▶ SELECT GAME</h2>

    <div class="slider-wrapper" @ref="sliderRef" @onscroll="HandleScroll">
        @foreach (var item in sampleGames)
        {
            <div class="slide-item">
                <div class="game-card">
                    <div class="card-img">
                        <img src="@(item.ImageUrl ?? "/images/games/brain-circuit.svg")" alt="@item.Name" />
                    </div>
                    <div class="card-body">
                        <p class="category">@item.Category.ToUpper()</p>
                        <h3>@item.Name.ToUpper()</h3>
                        <NavLink href="@item.href">
                            <button class="btn-play">▶ PLAY</button>
                        </NavLink>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="slider-dots">
        @for (int i = 0; i < sampleGames.Count; i++)
        {
            var index = i;
            <span class="dot @(currentIdx == index ? "active" : "")" @onclick="() => ManualScrollToIndex(index)"></span>
        }
    </div>
</div>

@code {
    private ElementReference sliderRef;
    private int currentIdx = 0;
    private System.Threading.Timer? timer;

    public class GameItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public string href { get; set; } = "";
        public string? ImageUrl { get; set; }
    }

    private List<GameItem> sampleGames = new()
{
new GameItem { Id = 1, Name = "Memory", Category = "Logic", ImageUrl = "/images/games/memory.png", href = "/game/memory"
},
new GameItem { Id = 2, Name = "MasterMind", Category = "Logic", ImageUrl = "/images/games/mastermind.png", href =
"/game/mastermind" },
new GameItem { Id = 3, Name = "Sudoku", Category = "Logic", ImageUrl = "/images/games/sudoku.png", href = "/game/sudoku"
},
new GameItem { Id = 4, Name = "Minesweeper", Category = "Classic", ImageUrl = "/images/games/minesweeper.png", href =
"/game/minesweeper" },
new GameItem { Id = 5, Name = "Tic Tac Toe vs AI",Category = "Strategy", ImageUrl = "/images/games/tictactoeAI.png",
href = "/game/tictactoewithai" },
new GameItem { Id = 6, Name = "Hangman", Category = "Word", ImageUrl = "/images/games/hangman.png", href =
"/game/hangman" },
new GameItem { Id = 7, Name = "Tic Tac Toe", Category = "Strategy", ImageUrl = "/images/games/ttt.png", href =
"/game/tictactoe" }
};

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            timer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
    {
                currentIdx = (currentIdx + 1) % sampleGames.Count;
                await ScrollToIndex(currentIdx);
                StateHasChanged();
            });
            }, null, 3000, 3000);
        }
    }

    private async Task ManualScrollToIndex(int index)
    {
        timer?.Change(3000, 3000);
        await ScrollToIndex(index);
    }

    private async Task ScrollToIndex(int index)
    {
        currentIdx = index;
        await JS.InvokeVoidAsync("eval", $@"
var el = document.querySelector('.slider-wrapper');
if(el) {{
var item = el.querySelector('.slide-item');
if(item) {{
var itemWidth = item.offsetWidth;
el.scrollTo({{ left: {index} * (itemWidth + 20), behavior: 'smooth' }});
}}
}}
");
    }

    private void HandleScroll(EventArgs e) { }

    public void Dispose() => timer?.Dispose();
}

<style>
    .slider-container {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 0;
        font-family: 'Press Start 2P', monospace;
    }

    .slider-title {
        font-size: 0.7rem;
        color: #ffe600;
        text-shadow: 2px 2px 0 #b38f00;
        text-align: center;
        margin-bottom: 24px;
        letter-spacing: 0.1em;
    }

    .slider-wrapper {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        gap: 20px;
        padding: 16px 10px 24px;
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .slider-wrapper::-webkit-scrollbar {
        display: none;
    }

    .slide-item {
        flex: 0 0 calc(33.333% - 14px);
        scroll-snap-align: center;
        display: flex;
        justify-content: center;
    }

    /* CARD */
    .game-card {
        background: #0d0d0d;
        border: 2px solid #222;
        width: 100%;
        max-width: 300px;
        display: flex;
        flex-direction: column;
        box-shadow: 4px 4px 0 #000;
        transition: all 0.1s steps(1);
        position: relative;
    }

    .game-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(180deg,
                transparent 0px, transparent 3px,
                rgba(255, 255, 255, 0.015) 3px, rgba(255, 255, 255, 0.015) 4px);
        pointer-events: none;
    }

    .game-card:hover {
        border-color: #ff7b00;
        box-shadow: 4px 4px 0 #ff7b00;
        transform: translate(-2px, -2px);
    }

    .card-img {
        height: 180px;
        background: #111;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 2px solid #1a1a1a;
        overflow: hidden;
    }

    .game-card:hover .card-img {
        border-bottom-color: #ff7b00;
    }

    .card-img img {
        max-height: 85%;
        max-width: 85%;
        object-fit: contain;
        filter: drop-shadow(0 0 8px rgba(255, 230, 0, 0.2));
        transition: filter 0.1s steps(2);
        image-rendering: pixelated;
    }

    .game-card:hover .card-img img {
        filter: drop-shadow(0 0 12px rgba(255, 123, 0, 0.5));
    }

    .card-body {
        padding: 16px;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
    }

    .category {
        font-size: 0.4rem;
        color: #555;
        letter-spacing: 0.15em;
        margin: 0;
    }

    .game-card:hover .category {
        color: #ff7b00;
    }

    .card-body h3 {
        font-size: 0.55rem;
        color: #ffffff;
        letter-spacing: 0.05em;
        margin: 0;
        line-height: 1.5;
    }

    .game-card:hover h3 {
        color: #ffe600;
        text-shadow: 0 0 8px rgba(255, 230, 0, 0.4);
    }

    .btn-play {
        background: #1a1a1a;
        color: #ffe600;
        border: 2px solid #ffe600;
        padding: 10px 16px;
        font-family: 'Press Start 2P', monospace;
        font-size: 0.5rem;
        cursor: pointer;
        width: 100%;
        box-shadow: 2px 2px 0 #b38f00;
        transition: all 0.1s steps(1);
        letter-spacing: 0.05em;
        margin-top: 8px;
    }

    .btn-play:hover {
        background: #ffe600;
        color: #000;
        box-shadow: 1px 1px 0 #b38f00;
        transform: translate(1px, 1px);
    }

    .game-card:hover .btn-play {
        border-color: #ff7b00;
        color: #ff7b00;
        box-shadow: 2px 2px 0 #b35000;
    }

    .game-card:hover .btn-play:hover {
        background: #ff7b00;
        color: #fff;
        box-shadow: 1px 1px 0 #b35000;
    }

    /* DOTS */
    .slider-dots {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 16px;
    }

    .dot {
        width: 8px;
        height: 8px;
        background: #222;
        border: 2px solid #333;
        cursor: pointer;
        transition: all 0.1s steps(1);
    }

    .dot:hover {
        border-color: #ff7b00;
        background: #ff7b00;
    }

    .dot.active {
        background: #ffe600;
        border-color: #ffe600;
        box-shadow: 0 0 6px rgba(255, 230, 0, 0.5);
    }

    @@media (max-width: 1024px) {
        .slide-item {
            flex: 0 0 calc(50% - 10px);
        }
    }

    @@media (max-width: 768px) {
        .slide-item {
            flex: 0 0 100%;
        }
    }
</style>