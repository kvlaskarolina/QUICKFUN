@page "/"
@using QuickFun.Web.Layout.ProductSliderComponent
@using QuickFun.Web.ViewModels
@inject HomeViewModel VM

<PageTitle>Home</PageTitle>

@if (!string.IsNullOrEmpty(VM.Nickname))
{
    <h1>Hello, @VM.Nickname!</h1>
    <p>Great to see you again. Ready to break some records?</p>
}
else
{
    <h1>Hello, world!</h1>
    <p>Try our amazing games. <a href="/login">Log in</a> to save your scores!</p>
}

<ProductSlider />

@code
{
    //widok tylko inicjalizuje na starcie
    protected override async Task OnInitializedAsync()
    {
        await VM.InitializeAsync();
    }
}