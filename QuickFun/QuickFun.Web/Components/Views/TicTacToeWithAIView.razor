@using QuickFun.Games.Engines
@using QuickFun.Domain.Enums
@using QuickFun.Games.Engines.TicTacToe.AI
@using QuickFun.Web.ViewModels
@using QuickFun.Games.TicTacToe.Strategies;
@namespace QuickFun.Web.Components.Views
@implements IDisposable
@inject TicTacToeWithAIViewModel VM

<div class="game-container">
    @if (VM.Engine == null)
    {
        <p class="loading-text">LOADING ENGINE...</p>
    }
    else
    {
        <div class="difficulty-buttons">
            <button class="btn-diff easy @(VM.SelectedLevel == Level.Easy ? "active" : "")"
                @onclick="() => VM.SetDifficulty(Level.Easy)">EASY</button>
            <button class="btn-diff medium @(VM.SelectedLevel == Level.Medium ? "active" : "")"
                @onclick="() => VM.SetDifficulty(Level.Medium)">MEDIUM</button>
            <button class="btn-diff hard @(VM.SelectedLevel == Level.Hard ? "active" : "")"
                @onclick="() => VM.SetDifficulty(Level.Hard)">HARD</button>
        </div>

        <p class="status-message">@VM.Engine.Message</p>
        <p class="score-text">SCORE: @VM.Engine.Score</p>

        <div class="board">
            @for (int i = 0; i < 9; i++)
            {
                int index = i;
                var symbol = VM.Engine.Board[index];
                <button class="cell @(symbol == 'X' ? "cell-x" : symbol == 'O' ? "cell-o" : "")"
                    @onclick="async () => await VM.MakeMove(index)"
                    disabled="@(VM.Engine.IsGameOver || VM.Engine.Board[index] != '\0')">
                    @(symbol != '\0' ? symbol.ToString() : "")
                </button>
            }
        </div>

        <button class="btn-undo" @onclick="VM.UndoMove" disabled="@VM.Engine.IsGameOver">
            ↩ UNDO
        </button>
    }
</div>

@code {
    [Parameter] public TicTacToeEngineWithAI Engine { get; set; } = default!;

    protected override void OnParametersSet()
    {
        VM.SetEngine(Engine);
        VM.OnNotifyView += HandleUpdate;
    }

    private void HandleUpdate() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        VM.OnNotifyView -= HandleUpdate;
        VM.Dispose();
    }
}

<style>
    .game-container {
        max-width: 420px;
        margin: 0 auto;
        padding: 24px 20px;
        text-align: center;
        background: #0a0a0a;
        font-family: 'Press Start 2P', monospace;
        color: #ffffff;
    }

    .loading-text {
        font-size: 0.6rem;
        color: #ffe600;
        animation: blink 1s steps(1) infinite;
    }

    blink {

        0%,
        100% {
            opacity: 1
        }

        50% {
            opacity: 0
        }
    }

    .difficulty-buttons {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .btn-diff {
        padding: 10px 16px;
        border: none;
        border-radius: 0;
        font-family: 'Press Start 2P', monospace;
        font-size: 0.5rem;
        color: #000;
        cursor: pointer;
        box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.5);
        transition: all 0.1s steps(1);
        letter-spacing: 0.05em;
    }

    .btn-diff:hover {
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0 rgba(0, 0, 0, 0.5);
    }

    .btn-diff.active {
        outline: 3px solid #ffffff;
        outline-offset: 2px;
    }

    .easy {
        background: #2ecc71;
    }

    .medium {
        background: #f39c12;
    }

    .hard {
        background: #e74c3c;
        color: #fff;
    }

    .status-message {
        font-size: 0.6rem;
        color: #ff7b00;
        text-shadow: 0 0 8px rgba(255, 123, 0, 0.5);
        min-height: 2rem;
        margin-bottom: 6px;
        letter-spacing: 0.05em;
    }

    .score-text {
        font-size: 0.55rem;
        color: #ffe600;
        margin-bottom: 16px;
        letter-spacing: 0.08em;
    }

    .board {
        display: grid;
        grid-template-columns: repeat(3, 100px);
        gap: 8px;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .cell {
        width: 100px;
        height: 100px;
        font-size: 2rem;
        font-family: 'Press Start 2P', monospace;
        font-weight: bold;
        cursor: pointer;
        background: #1a1a1a;
        border: 2px solid #333;
        border-radius: 0;
        color: #ffffff;
        box-shadow: 3px 3px 0 #000;
        transition: all 0.1s steps(1);
    }

    .cell:hover:not(:disabled) {
        background: rgba(255, 123, 0, 0.15);
        border-color: #ff7b00;
        box-shadow: 1px 1px 0 #000;
        transform: translate(2px, 2px);
    }

    .cell:disabled {
        cursor: not-allowed;
    }

    .cell-x {
        color: #ff7b00;
        text-shadow: 0 0 10px rgba(255, 123, 0, 0.6);
        border-color: #ff7b00;
    }

    .cell-o {
        color: #ffe600;
        text-shadow: 0 0 10px rgba(255, 230, 0, 0.6);
        border-color: #ffe600;
    }

    .btn-undo {
        padding: 10px 20px;
        font-family: 'Press Start 2P', monospace;
        font-size: 0.5rem;
        background: #1a1a1a;
        color: #ffe600;
        border: 2px solid #ffe600;
        cursor: pointer;
        box-shadow: 2px 2px 0 #b38f00;
        transition: all 0.1s steps(1);
        letter-spacing: 0.05em;
    }

    .btn-undo:hover:not(:disabled) {
        background: #ffe600;
        color: #000;
        box-shadow: 1px 1px 0 #b38f00;
        transform: translate(1px, 1px);
    }

    .btn-undo:disabled {
        opacity: 0.3;
        cursor: not-allowed;
        box-shadow: none;
    }
</style>