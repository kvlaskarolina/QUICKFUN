@page "/leaderboard"
@using QuickFun.Domain.Enums
@using QuickFun.Domain.Entities
@using QuickFun.Web.ViewModels

@inject LeaderboardViewModel VM

<div class="stats-container">
    <h2>Hall of Fame</h2>

    <div class="tabs">
    @*automatycznie tworzy przycisk dla kazdej gry z Enuma*@
        @foreach (GameType type in Enum.GetValues(typeof(GameType)))
        {
            <button class="tab-btn @(VM.selectedGame == type ? "active" : "")"
                    @onclick="() => VM.ChangeGame(type)">
                @type
            </button>
        }
    </div>

    <div class="grid-stats">
        <section class="stat-section">
            <h3>Global Top 5</h3>
            @if (VM.topScores == null) { <p>Loading...</p> }
            else {
                <table class="table">
                    <thead><tr><th>Player</th><th>Best Score</th></tr></thead>
                    <tbody>
                        @foreach (var entry in VM.topScores) {
                            <tr><td>@entry.Username</td><td>@entry.Score</td></tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="stat-section my-stats">
    <h3>My Stats (@VM.selectedGame)</h3>

    @if (!VM.isLoggedIn)
    {
        @* gostek jest gosciem*@
        <div class="auth-prompt">
            <p>You are not logged in.</p>
            <a href="/login?returnUrl=/leaderboard" class="btn-link">Log in to track your scores!</a>
        </div>
    }
    else if (VM.myCurrentGameStat == null)
    {
        @*zalogowany ale nie gral jeszcze w ta gre *@
        <div class="no-data-prompt">
            <p>You haven't played <strong>@VM.selectedGame</strong> yet.</p>
            <p>Go to the home page and play a session to see your rank here!</p>
        </div>
    }
    else
    {
        @*zalogowany i ma już jakieś punkty w tej grze*@
        <div class="my-score-card">
            <p>Best: <strong>@VM.myCurrentGameStat.BestScore</strong></p>
            <p>Total: @VM.myCurrentGameStat.TotalScore</p>
            <p>Games played: @VM.myCurrentGameStat.GamesPlayed</p>
        </div>
    }
</section>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await VM.RefreshData();
    }
}

<style>
    .stats-container { max-width: 800px; margin: 20px auto; color: #333; }
    .tabs { display: flex; gap: 10px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 10px; }
    .tab-btn { padding: 8px 16px; border: none; border-radius: 20px; cursor: pointer; background: #eee; }
    .tab-btn.active { background: #007bff; color: white; }
    .grid-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
    .stat-section { background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
    .table { width: 100%; border-collapse: collapse; }
    .table th, .table td { text-align: left; padding: 10px; border-bottom: 1px solid #eee; }
    .my-score-card { background: #f0f7ff; padding: 15px; border-radius: 8px; border-left: 4px solid #007bff; }
    .no-data-prompt {
        background-color: #fffaf0;
        border-left: 4px solid #f6ad55;
        padding: 15px;
        border-radius: 8px;
        color: #7b341e;
    }

    .auth-prompt {
        background-color: #f7fafc;
        border: 1px dashed #cbd5e0;
        padding: 15px;
        border-radius: 8px;
        text-align: center;
    }

    .btn-link {
        color: #007bff;
        text-decoration: underline;
        font-weight: bold;
    }
</style>
