@using QuickFun.Games.Engines.MasterMind
@using QuickFun.Games.MasterMind.Strategies
@using QuickFun.Domain.Enums
@using QuickFun.Application.Interfaces
@using QuickFun.Domain.Entities

@inject IGameSessionService SessionService

@namespace QuickFun.Web.Components.Views

<div class="mastermind-view">
    @if (!isDifficultySelected)
    {
        <div class="difficulty-overlay">
            <h3>Choose difficulty</h3>
            <div class="difficulty-buttons">
                <button class="btn-diff easy" @onclick="() => SelectDifficulty(new EasyStrategyMasterMind())">
                    Easy <small>(4 colors, 4 slots)</small>
                </button>
                <button class="btn-diff medium" @onclick="() => SelectDifficulty(new MediumStrategyMasterMind())">
                    Medium <small>(5 colors, 5 slots)</small>
                </button>
                <button class="btn-diff hard" @onclick="() => SelectDifficulty(new HardStrategyMasterMind())">
                    Hard <small>(6 colors, 6 slots)</small>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="game-header">
            <p class="status-message">@Engine.Message</p>
            <p class="score">Attempts: @Engine.Score / @Engine.MaxAttempts</p>
            <button class="btn-change-level" @onclick="ChangeDifficulty">
                <span>«</span> Change difficulty
            </button>
        </div>

        @* Color palette legend *@
        <div class="color-legend">
            @for (int i = 0; i < Engine.Colors; i++)
            {
                var letter = ((char)('A' + i)).ToString();
                <div class="legend-item">
                    <div class="color-dot" style="background-color: @GetColor(letter)"></div>
                    <span>@letter</span>
                </div>
            }
        </div>

        @* Guess history *@
        <div class="guess-history">
            @foreach (var (guess, correctPos, correctCol) in Engine.GuessHistory)
            {
                <div class="guess-row">
                    <div class="guess-pegs">
                        @foreach (var ch in guess)
                        {
                            <div class="peg" style="background-color: @GetColor(ch.ToString())">@ch</div>
                        }
                    </div>
                    <div class="feedback">
                        <span class="feedback-black" title="Correct position">⬛ @correctPos</span>
                        <span class="feedback-white" title="Correct color, wrong position">⬜ @correctCol</span>
                    </div>
                </div>
            }
        </div>

        @* Input area *@
        @if (!Engine.IsGameOver)
        {
            <div class="input-area">
                <div class="peg-input">
                    @for (int i = 0; i < Engine.CodeLength; i++)
                    {
                        var index = i;
                        <select class="peg-select" @bind="currentGuess[index]">
                            <option value="">?</option>
                            @for (int c = 0; c < Engine.Colors; c++)
                            {
                                var letter = ((char)('A' + c)).ToString();
                                <option value="@letter">@letter</option>
                            }
                        </select>
                    }
                </div>
                <button class="btn-submit" @onclick="SubmitGuess" disabled="@(!IsGuessComplete())">
                    Submit Guess
                </button>
            </div>
        }
        else
        {
            <div class="game-over-actions">
                <button class="btn-play-again" @onclick="PlayAgain">Play Again</button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public MasterMindEngine Engine { get; set; } = default!;

    private bool isDifficultySelected = false;
    private string[] currentGuess = Array.Empty<string>();

    protected override void OnInitialized()
    {
        Engine.OnGameFinished -= HandleSaveScore;
        Engine.OnGameFinished += HandleSaveScore;
    }

    private async Task SelectDifficulty(IMasterMindDifficultyStrategy strategy)
    {
        Engine.SetDifficulty(strategy);
        isDifficultySelected = true;
        currentGuess = new string[Engine.CodeLength];
        await Engine.Start(() => InvokeAsync(StateHasChanged));
    }

    private void ChangeDifficulty()
    {
        isDifficultySelected = false;
        Engine.OnReset();
    }

    private async Task PlayAgain()
    {
        currentGuess = new string[Engine.CodeLength];
        await Engine.Start(() => InvokeAsync(StateHasChanged));
    }

    private bool IsGuessComplete() =>
    currentGuess.Length == Engine.CodeLength && currentGuess.All(c => !string.IsNullOrEmpty(c));

    private async Task SubmitGuess()
    {
        if (!IsGuessComplete()) return;
        var guess = string.Join("", currentGuess);
        currentGuess = new string[Engine.CodeLength];
        await Engine.MakeGuess(guess, () => InvokeAsync(StateHasChanged));
    }

    private async void HandleSaveScore(int finalScore)
    {
        var result = new GameResult
        {
            Type = Engine.Type,
            Score = finalScore
        };
        await SessionService.AddGameResultAsync(result);
        await InvokeAsync(StateHasChanged);
    }

    private static string GetColor(string letter) => letter switch
    {
        "A" => "#e74c3c",
        "B" => "#3498db",
        "C" => "#2ecc71",
        "D" => "#f39c12",
        "E" => "#9b59b6",
        "F" => "#1abc9c",
        _ => "#aaaaaa"
    };
}

<style>
    .mastermind-view {
        width: 100%;
        max-width: 520px;
        margin: 0 auto;
        padding-bottom: 45px;
        font-family: sans-serif;
    }

    /* --- Difficulty Screen --- */
    .difficulty-overlay {
        text-align: center;
        padding: 20px;
    }

    .difficulty-buttons {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 15px;
    }

    .btn-diff {
        padding: 15px;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        color: white;
        cursor: pointer;
        transition: transform 0.2s;
        font-size: 1.1rem;
    }

    .btn-diff:hover {
        transform: scale(1.02);
    }

    .btn-diff small {
        display: block;
        font-weight: normal;
        opacity: 0.8;
        font-size: 0.8rem;
    }

    .easy {
        background-color: #27ae60;
    }

    .medium {
        background-color: #f39c12;
    }

    .hard {
        background-color: #e74c3c;
    }

    /* --- Game Header --- */
    .game-header {
        text-align: center;
        margin-bottom: 12px;
    }

    .status-message {
        font-size: 1.1rem;
        font-weight: bold;
        margin-bottom: 4px;
        min-height: 1.5em;
    }

    .score {
        color: #666;
        margin-bottom: 8px;
        font-size: 0.95rem;
    }

    .btn-change-level {
        background-color: #0086fc;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        font-size: 0.9rem;
        transition: background-color 0.2s, transform 0.1s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-change-level:hover {
        background-color: #5a6268;
        transform: translateY(-1px);
    }

    /* --- Color Legend --- */
    .color-legend {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .legend-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
        font-size: 0.8rem;
        font-weight: bold;
        color: #444;
    }

    .color-dot {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid rgba(0, 0, 0, 0.15);
    }

    /* --- Guess History --- */
    .guess-history {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 16px;
        max-height: 340px;
        overflow-y: auto;
    }

    .guess-row {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #f4f4f4;
        border-radius: 8px;
        padding: 6px 10px;
    }

    .guess-pegs {
        display: flex;
        gap: 6px;
    }

    .peg {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 2px solid rgba(0, 0, 0, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: white;
        font-size: 0.9rem;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
    }

    .feedback {
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: 0.85rem;
        min-width: 70px;
    }

    .feedback-black {
        color: #222;
        font-weight: bold;
    }

    .feedback-white {
        color: #888;
    }

    /* --- Guess Input --- */
    .input-area {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        margin-top: 8px;
    }

    .peg-input {
        display: flex;
        gap: 8px;
    }

    .peg-select {
        width: 52px;
        height: 48px;
        border-radius: 6px;
        border: 2px solid #ccc;
        font-size: 1rem;
        font-weight: bold;
        text-align: center;
        cursor: pointer;
        background: white;
    }

    .peg-select:focus {
        outline: none;
        border-color: #3498db;
    }

    .btn-submit {
        background-color: #2ecc71;
        color: white;
        border: none;
        padding: 10px 28px;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.2s, transform 0.1s;
    }

    .btn-submit:hover:not(:disabled) {
        background-color: #27ae60;
        transform: translateY(-1px);
    }

    .btn-submit:disabled {
        background-color: #aaa;
        cursor: not-allowed;
    }

    /* --- Game Over --- */
    .game-over-actions {
        text-align: center;
        margin-top: 16px;
    }

    .btn-play-again {
        background-color: #3498db;
        color: white;
        border: none;
        padding: 12px 32px;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.2s, transform 0.1s;
    }

    .btn-play-again:hover {
        background-color: #2980b9;
        transform: translateY(-1px);
    }
</style>