@page "/game/{GameTypeString}"

@using QuickFun.Domain.Enums
@using QuickFun.Games
@using QuickFun.Games.Engines
@using QuickFun.Games.Engines.TicTacToe.AI
@using QuickFun.Games.Engines.TicTacToe
@using QuickFun.Games.Engines.MasterMind
@using QuickFun.Games.Memory
@using QuickFun.Games.Hangman
@using QuickFun.Games.Minesweeper
@using QuickFun.Web.Components.Views
@using QuickFun.Games.Engines.Sudoku

@inject IGameFactory GameFactory
@inject NavigationManager Navigation

<div class="game-layout">
    @if (CurrentGame == null)
    {
        <div class="error-container">
            <p class="error-code">404</p>
            <h2 class="error-title">GAME NOT FOUND</h2>
            <p class="error-msg">Sorry, "@GameTypeString" does not exist.</p>
            <a href="/" class="btn-action secondary">« GO BACK</a>
        </div>
    }
    else
    {
        <h1 class="game-title">@CurrentGame.Name.ToUpper()</h1>

        <div class="game-content">
            @if (CurrentGame is TicTacToeEngineWithAI tttai)
            {
                <TicTacToeWithAIView Engine="tttai" />
            }
            else if (CurrentGame is TicTacToeEngine ttt)
            {
                <TicTacToeView Engine="ttt" />
            }
            else if (CurrentGame is MemoryEngine memory)
            {
                <MemoryView Engine="memory" />
            }
            else if (CurrentGame is HangmanEngine hangman)
            {
                <HangmanView Engine="hangman" OnDifficultyChange="OnHangmanDifficultyChanged" />
            }
            else if (CurrentGame is SudokuEngine sudoku)
            {
                <SudokuView Engine="sudoku" />
            }
            else if (CurrentGame is MinesweeperEngine ms)
            {
                <MinesweeperView Engine="ms" />
            }
            else if (CurrentGame is MasterMindEngine mm)
            {
                <MasterMindView Engine="mm" />
            }
        </div>

        <div class="controls">
            <button class="btn-action primary"   @onclick="Reset">▶ RESTART</button>
            <button class="btn-action secondary"  @onclick="GoBack">« QUICKFUN</button>
        </div>
    }
</div>

@code {
    [Parameter] public string? GameTypeString { get; set; }

    private IGameEngine? CurrentGame { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Enum.TryParse<GameType>(GameTypeString, true, out var type))
        {
            CurrentGame = GameFactory.CreateGame(type);

            if (CurrentGame is MemoryEngine memory)
                await memory.Start(() => InvokeAsync(StateHasChanged));
            else if (CurrentGame is HangmanEngine)
            { /* user picks difficulty first */ }
            else
                CurrentGame.Reset();
        }
        else
        {
            CurrentGame = null;
        }
    }

    private async Task Reset()
    {
        if (CurrentGame == null) return;
        CurrentGame.Reset();
        if (CurrentGame is MemoryEngine memory)
            await memory.Start(() => InvokeAsync(StateHasChanged));
        if (CurrentGame is SudokuEngine sudoku)
            await sudoku.Start(() => InvokeAsync(StateHasChanged));
        if (CurrentGame is MasterMindEngine mastermind)
            await mastermind.Start(() => InvokeAsync(StateHasChanged));
        StateHasChanged();
    }

    private void GoBack() => Navigation.NavigateTo("/");

    private void OnHangmanDifficultyChanged(HangmanDifficulty difficulty)
    {
        CurrentGame = HangmanFactory.CreateGame(difficulty);
        CurrentGame.Reset();
        StateHasChanged();
    }
}

<style>
    .game-layout {
        max-width: 760px;
        margin: 2rem auto;
        padding: 36px 40px;
        text-align: center;
        background: #000000;
        border: 2px solid #222;
        box-shadow: 6px 6px 0 #000;
        font-family: 'Press Start 2P', monospace;
    }

    .game-title {
        color: #ffe600;
        margin-bottom: 1.5rem;
        font-size: 1.2rem;
        letter-spacing: 0.08em;
        text-shadow: 3px 3px 0 #b38f00, 0 0 20px rgba(255,230,0,0.3);
    }

    .game-content {
        margin: 2rem 0;
        min-height: 300px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .controls {
        display: flex;
        gap: 14px;
        justify-content: center;
        margin-top: 2rem;
        flex-wrap: wrap;
    }

    .btn-action {
        padding: 12px 22px;
        font-family: 'Press Start 2P', monospace;
        font-size: 0.55rem;
        border: none;
        cursor: pointer;
        box-shadow: 3px 3px 0;
        transition: all 0.1s steps(1);
        letter-spacing: 0.05em;
        text-decoration: none;
        display: inline-block;
    }

    .btn-action:hover { transform: translate(2px,2px); }

    .btn-action.primary {
        background: #ffe600;
        color: #000;
        box-shadow: 3px 3px 0 #b38f00;
    }
    .btn-action.primary:hover {
        background: #ff7b00;
        color: #fff;
        box-shadow: 1px 1px 0 #b35000;
    }

    .btn-action.secondary {
        background: #1a1a1a;
        color: #ffe600;
        border: 2px solid #ffe600;
        box-shadow: 3px 3px 0 #b38f00;
    }
    .btn-action.secondary:hover {
        background: #ffe600;
        color: #000;
        box-shadow: 1px 1px 0 #b38f00;
    }

    /* ERROR */
    .error-container { padding: 40px 20px; }

    .error-code {
        font-size: 4rem;
        color: #e74c3c;
        text-shadow: 4px 4px 0 #7b1c12;
        margin-bottom: 10px;
    }

    .error-title {
        font-size: 0.8rem;
        color: #ffe600;
        margin-bottom: 12px;
        letter-spacing: 0.1em;
    }

    .error-msg {
        font-size: 0.5rem;
        color: #888;
        margin-bottom: 24px;
        letter-spacing: 0.05em;
    }
</style>
