@using QuickFun.Games.Minesweeper
@using QuickFun.Web.ViewModels
@namespace QuickFun.Web.Components.Views
@implements IDisposable
@inject MinesweeperViewModel VM

<div class="saper-container">
    <div class="saper-header">
        <div class="status-box">
            <span class="status-text @(VM.Engine.IsWin ? "win-text" : VM.Engine.IsGameOver ? "loss-text" : "")">
                @VM.Engine.Message
            </span>
        </div>
        <div class="stats-bar">
            <div class="stat-item">
                <span class="label">POINTS</span>
                <span class="value">@Engine.Score</span>
            </div>
            <div class="stat-item">
                <span class="label">MINES</span>
                <span class="value">20</span>
            </div>
        </div>
    </div>

    <div class="saper-board">
        @for (int r = 0; r < 12; r++)
        {
            <div class="saper-row">
                @for (int c = 0; c < 12; c++)
                {
                    var row = r;
                    var col = c;
                    var cell = VM.Engine.Board[row, col];

                    <div class="saper-cell
                                                @(cell.IsRevealed ? "revealed" : "hidden")
                                                @((cell.IsMine && cell.IsRevealed && !VM.Engine.IsWin) ? "mine-loss" : "")
                                                @((cell.IsMine && cell.IsRevealed && VM.Engine.IsWin) ? "mine-win" : "")"
                        @onclick="() => VM.Engine.HandleClick(row, col)" @oncontextmenu:preventDefault="true"
                        @oncontextmenu="() => VM.Engine.SwitchFlag(row, col)">

                        @if (cell.IsFlagged && !cell.IsRevealed)
                        {
                            <span class="flag">🚩</span>
                        }
                        else if (cell.IsRevealed)
                        {
                            if (cell.IsMine)
                            {
                                <span class="icon">💣</span>
                            }
                            else if (cell.AdjMines > 0)
                            {
                                <span class="number n-@cell.AdjMines">@cell.AdjMines</span>
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (VM.Engine.IsGameOver)
    {
        <div class="saper-footer">
            <button class="btn-reset" @onclick="Engine.Reset">
                ▶ PLAY AGAIN
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public MinesweeperEngine Engine { get; set; } = default!;

    protected override void OnParametersSet()
    {
        VM.SetEngine(Engine);
        VM.OnNotifyView += HandleUpdate;
    }

    private void HandleUpdate() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        VM.OnNotifyView -= HandleUpdate;
        VM.Dispose();
    }
}

<style>
    .saper-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: #0a0a0a;
        padding: 20px;
        border: 2px solid #333;
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
        user-select: none;
        max-width: fit-content;
        margin: 0 auto;
        font-family: 'Press Start 2P', monospace;
    }

    .saper-header {
        width: 100%;
        margin-bottom: 16px;
        text-align: center;
    }

    .status-text {
        font-size: 0.6rem;
        color: #ffffff;
        display: block;
        margin-bottom: 12px;
        min-height: 1.6em;
        letter-spacing: 0.05em;
    }

    .win-text {
        color: #2ecc71;
        text-shadow: 0 0 10px rgba(46, 204, 113, 0.6);
    }

    .loss-text {
        color: #e74c3c;
        text-shadow: 0 0 10px rgba(231, 76, 60, 0.6);
    }

    .stats-bar {
        display: flex;
        justify-content: space-around;
        background: #111;
        color: #ffe600;
        font-family: 'Press Start 2P', monospace;
        padding: 8px;
        border: 2px solid #ffe600;
        box-shadow: 0 0 8px rgba(255, 230, 0, 0.2);
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

    .stat-item .label {
        font-size: 0.4rem;
        color: #888;
        letter-spacing: 0.1em;
    }

    .stat-item .value {
        font-size: 0.9rem;
        color: #ffe600;
    }

    .saper-board {
        border: 3px solid #ffe600;
        background: #111;
        padding: 3px;
        box-shadow: 0 0 12px rgba(255, 230, 0, 0.15);
    }

    .saper-row {
        display: flex;
    }

    .saper-cell {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.7rem;
        cursor: pointer;
        box-sizing: border-box;
        transition: background-color 0.05s;
        font-family: 'Press Start 2P', monospace;
    }

    .hidden {
        background: #222;
        border: 2px solid #444;
        box-shadow: inset -1px -1px 0 #111, inset 1px 1px 0 #333;
    }

    .hidden:hover {
        background: #ff7b00;
        border-color: #ff7b00;
    }

    .revealed {
        background: #111;
        border: 1px solid #1e1e1e;
    }

    .mine-loss {
        background: #e74c3c !important;
        border: 1px solid #c0392b;
    }

    .mine-win {
        background: #2ecc71 !important;
        border: 1px solid #27ae60;
    }

    .number {
        font-size: 0.65rem;
        font-family: 'Press Start 2P', monospace;
    }

    .n-1 {
        color: #3498db;
    }

    .n-2 {
        color: #2ecc71;
    }

    .n-3 {
        color: #e74c3c;
    }

    .n-4 {
        color: #9b59b6;
    }

    .n-5 {
        color: #f39c12;
    }

    .n-6 {
        color: #1abc9c;
    }

    .saper-footer {
        margin-top: 16px;
    }

    .btn-reset {
        padding: 12px 24px;
        font-family: 'Press Start 2P', monospace;
        font-size: 0.6rem;
        background: #ffe600;
        color: #000;
        border: none;
        cursor: pointer;
        box-shadow: 3px 3px 0 #b38f00;
        transition: all 0.1s steps(1);
        letter-spacing: 0.05em;
    }

    .btn-reset:hover {
        background: #ff7b00;
        color: #fff;
        box-shadow: 1px 1px 0 #b35000;
        transform: translate(2px, 2px);
    }
</style>