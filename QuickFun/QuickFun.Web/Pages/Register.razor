    .btn-submit { width: 100%; padding: 12px; background: #28a745; color: white; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; }
    .btn-submit:hover { background: #218838; }
    .error-msg { color: red; margin-top: 15px; }
    .success-msg { color: green; margin-top: 15px; font-weight: bold; }
</style>