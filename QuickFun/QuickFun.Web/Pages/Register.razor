@page "/register"
@using QuickFun.Web.ViewModels
@inject RegisterViewModel VM


<div class="auth-container">
    <h2>Create Account</h2>

    <div class="input-group">
        <label>Email</label>
        <input @bind="VM.email" type="email" placeholder="Enter your email" />
    </div>

    <div class="input-group">
        <label>Login (Username)</label>
        <input @bind="VM.username" type="text" placeholder="Enter username" />
    </div>

    <div class="input-group">
        <label>Password</label>
        <input @bind="VM.password" type="password" placeholder="Enter password" />
    </div>

    <button class="btn-submit" @onclick="VM.HandleRegister">Sign up</button>

    @if (!string.IsNullOrEmpty(VM.errorMessage))
    {
        <p class="error-msg">@VM.errorMessage</p>
    }
    @if (VM.isSuccess)
    {
        <div class="success-msg">
            Account created successfully! <br />
            <a href="/login">Click here to log in.</a>
        </div>
    }
</div>

